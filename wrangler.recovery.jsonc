{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zhuole-recovery-rehearsal",
  "main": "cloud/recovery-rehearsal.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
