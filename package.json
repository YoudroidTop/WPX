{
  "name": "zhuole-docs",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron desktop-dist",
    "desktop:pack:mac": "npm run desktop:build && electron-builder --config electron-builder.yml --mac --publish never",
    "desktop:pack:win": "npm run desktop:build && electron-builder --config electron-builder.yml --win --x64 --publish never && electron-builder --config electron-builder.yml --win --arm64 --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "mobile:sync": "npm run build && cap sync",
    "cloud:dev": "wrangler dev --port 8787 --var APP_ORIGIN:http://127.0.0.1:8787",
    "cloud:build": "tsc -p tsconfig.cloud.json && npm run build && wrangler deploy --dry-run --outdir releases/cloudflare",
    "test:cloud": "node tests/cloud-integration.mjs",
    "test:cloud:browser": "playwright test --config playwright.cloud.config.ts",
    "harmony:sync": "npm run build && node scripts/build-harmony.mjs",
    "desktop:verify-release": "node scripts/verify-desktop-release.mjs",
    "desktop:pack:mac:signed": "npm run desktop:build && electron-builder --config electron-builder.macos-release.yml --mac --publish never",
    "desktop:verify:mac-distribution": "node scripts/verify-mac-distribution.mjs",
    "mobile:pack:android": "node scripts/build-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@tiptap/extension-color": "^3.31.4",
    "@tiptap/extension-font-family": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cookie-parser": "^1.4.7",
    "docx": "^9.10.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@playwright/test": "^1.64.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
