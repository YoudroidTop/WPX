{
  "name": "zhuole-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:dev": "npm run desktop:build && electron desktop-dist",
    "desktop:pack:mac": "npm run desktop:build && electron-builder --config electron-builder.yml --mac --publish never",
    "desktop:pack:win": "npm run desktop:build && electron-builder --config electron-builder.yml --win --publish never",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "cookie-parser": "^1.4.7",
    "docx": "^9.10.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
